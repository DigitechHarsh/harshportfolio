# Prevent execution of PHP scripts in uploads directory
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|phtml|pl|py|jsp|asp|htm|shtml|sh|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow public streaming & viewing of video and image files
<FilesMatch "(?i)\.(mp4|webm|mov|m4v|jpg|jpeg|png|webp|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

Options -Indexes
